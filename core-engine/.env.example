# App & Environment
APP_ENV=development
LOG_LEVEL=INFO
PORT=8000
PUBLIC_URL=https://your-domain-or-ngrok.ngrok-free.app
DATABASE_URL=sqlite:///./calling_agent.db
API_KEY_SECRET=change-this-secret-for-fastapi-auth

# Provider Selection
# STT options: deepgram, sarvam
STT_PROVIDER=deepgram
# LLM options: openai, groq
LLM_PROVIDER=openai
# TTS options: openai, cartesia, sarvam, elevenlabs
TTS_PROVIDER=openai
# Telephony options: twilio, exotel, tata_smartflo
TELEPHONY_PROVIDER=twilio

# LLM Keys & Config
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
LLM_MODEL=gpt-4o-mini


# STT Keys & Config
DEEPGRAM_API_KEY=
SARVAM_API_KEY=

# TTS Keys & Config
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Telephony: Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Telephony: Exotel
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=
EXOTEL_CALLER_ID=

# Webhooks & Security
WEBHOOK_SECRET=your-secure-sha256-hmac-secret-key

# Concurrency & Scaling
MAX_CONCURRENT_CALLS=20
MAX_OVERLOAD_QUEUE_SIZE=50

# Usage Cost Calculation Rates (USD)
RATE_STT_PER_MINUTE=0.0043
RATE_LLM_INPUT_1K=0.00059
RATE_LLM_OUTPUT_1K=0.00079
RATE_TTS_1K_CHARS=0.015
RATE_TELEPHONY_PER_MINUTE=0.014

# Hugging Face Settings
HUGGINGFACE_API_KEY=hf_your_huggingface_token
HUGGINGFACE_LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
HUGGINGFACE_TTS_MODEL=facebook/mms-tts-eng
HUGGINGFACE_SENTIMENT_MODEL=distilbert/distilbert-base-uncased-finetuned-sst-2-english
