{
  "name": "callforge-smart-ai-dialer",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "CallForge Smart AI Dialer with Unified Python Core Voice Agent Engine",
  "scripts": {
    "dev": "npm --prefix callforge-ops run dev",
    "dev:all": "powershell -ExecutionPolicy Bypass -File ./start-system.ps1",
    "dev:node": "npm --prefix callforge-ops run dev",
    "dev:agent": "python core-engine/server.py",
    "dev:agent:reload": "uvicorn server:app --app-dir core-engine --host 0.0.0.0 --port 8000 --reload",
    "build": "npm --prefix callforge-ops install && npm --prefix callforge-ops run build",
    "start": "npm --prefix callforge-ops run start",
    "check": "npm --prefix callforge-ops run check",
    "test": "npm --prefix callforge-ops test",
    "deploy:vercel": "node -e \"fetch('https://api.vercel.com/v1/integrations/deploy/prj_achNYYSGPCG7xlKWCORJNMivgtmh/JSwjsxAPan', { method: 'POST' }).then(() => console.log('Vercel Redeploy Triggered!'))\"",
    "push": "git add . && git commit -m \"team update\" && git pull --rebase origin main && git push origin main && npm run deploy:vercel"
  },
  "dependencies": {
    "firebase": "^11.4.0",
    "nodemailer": "^6.9.16"
  }
}
