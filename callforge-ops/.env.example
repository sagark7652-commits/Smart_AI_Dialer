# Server Configuration
PORT=3000
NODE_ENV=development
PUBLIC_APP_URL=https://your-public-url.ngrok-free.app # Required for live carrier WebSockets

# Telephony Carrier Configuration (Choose at least one for live calling to +91 numbers)
DEFAULT_TELEPHONY_PROVIDER=twilio # twilio | exotel | tata | bolna | mock

# 1. Twilio Configuration (Fastest for testing)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_CALLER_ID=+18005550199

# 2. Exotel Configuration (India PRI / Virtual Numbers)
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SID=

# 3. Tata Smartflo Configuration
TATA_SMARTFLO_API_KEY=
TATA_SMARTFLO_TOKEN=
TATA_SIP_TRUNK=sip.tatasmartflo.com:5060

# 4. Bolna AI Agent Gateway
BOLNA_API_KEY=

# Speech & LLM Intelligence
OPENAI_API_KEY=
GROQ_API_KEY=
DEEPGRAM_API_KEY=

# Database & Auth
JWT_SECRET=development-secret-key-change-in-production-min-32-chars
DATABASE_URL=mysql://root:password@localhost:3306/callforge_ops
